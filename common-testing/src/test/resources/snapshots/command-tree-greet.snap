greet (aliases: hi) [myplugin.command.greet, OP]
  --loud, -l
  --times, -t <value>
  <name: CommonStringArgument> [myplugin.command.greet.name, ALL]
  admin [myplugin.command.greet.admin, OP]
    <level: CommonIntegerArgument> <reason: CommonStringArgument> [myplugin.command.greet.admin.level.reason, OP]
